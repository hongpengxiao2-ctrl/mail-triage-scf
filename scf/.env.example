# qq-mail-triage 本地运行配置模板
# 复制为 .env 后填入真实值；.env 仅本机使用，不要提交到任何仓库。
# 云端运行时这些变量配在腾讯云函数的环境变量里，不需要本文件。

# ---- 必填：QQ 邮箱 ----
# 授权码在 QQ 邮箱「设置 → 账户 → IMAP/SMTP服务」开启后生成，不是登录密码
QQ_EMAIL_ACCOUNT=
QQ_EMAIL_AUTH_CODE=

# ---- 必填：企业微信群机器人 Webhook（双通道）----
# 告警通道：即时重要邮件提醒
WECOM_WEBHOOK=
# 日报通道：每日 10:00 摘要日报；留空则自动回退到 WECOM_WEBHOOK
WECOM_WEBHOOK_REPORT=

# ---- 必填：腾讯云 COS（存放去重状态与日报暂存）----
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=

# ---- 本机专属配置（deploy_scf.py 读取；本文件可放在项目外）----
# 凭据文件的绝对路径；留空则只从上面的环境变量取
TENCENT_CRED_FILE=
# 可选：从既有函数继承企业微信 Webhook 与 COS 配置，避免重复维护
SOURCE_FUNCTION=

# ---- 可选：行为开关 ----
# 1 = 只判定不移动邮件（首次验证建议设为 1）
DRY_RUN=1
# 扫描最近多少天的邮件
SCAN_DAYS=7
# 二维码邮件超过多少分钟视为失效
QR_EXPIRE_MINUTES=30
# 单轮最多处理 / 最多移入回收站的邮件数
MAX_PROCESS_PER_RUN=25
MAX_TRASH_PER_RUN=60
# 重要邮件即时推送的去重窗口（小时）：同一「发件人+主题」在窗口内只推一次
# 设为 0 关闭去重（每封都推）；不影响日报，日报中始终完整保留
IMPORTANT_DEDUP_HOURS=24
# 回收站文件夹名；留空则按 IMAP \Trash 属性自动识别
TRASH_FOLDER=
# 自定义豁免（逗号分隔子串，命中发件人/显示名/主题即永不清理）
PROTECT_EXTRA=
