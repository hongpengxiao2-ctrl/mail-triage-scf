# qq-mail-triage 本地运行配置模板
# 复制为 .env 后填入真实值；.env 仅本机使用，不要提交到任何仓库。
# 云端运行时这些变量配在腾讯云函数的环境变量里，不需要本文件。

# ---- 必填：QQ 邮箱 ----
# 授权码在 QQ 邮箱「设置 → 账户 → IMAP/SMTP服务」开启后生成，不是登录密码
QQ_EMAIL_ACCOUNT=
QQ_EMAIL_AUTH_CODE=

# ---- 必填：企业微信群机器人 Webhook（双通道）----
# 告警通道：即时重要邮件提醒
WECOM_WEBHOOK=
# 日报通道：每日 10:00 摘要日报；留空则自动回退到 WECOM_WEBHOOK
WECOM_WEBHOOK_REPORT=

# ---- 必填：腾讯云 COS（存放去重状态与日报暂存）----
COS_BUCKET=
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=

# ---- 本机专属配置（deploy_scf.py 读取；本文件可放在项目外）----
# 凭据文件的绝对路径；留空则只从上面的环境变量取
TENCENT_CRED_FILE=
# 可选：从既有函数继承企业微信 Webhook 与 COS 配置，避免重复维护
SOURCE_FUNCTION=

# ---- 可选：行为开关 ----
# 1 = 只判定不移动邮件（首次验证建议设为 1）
DRY_RUN=1
# 扫描最近多少天的邮件
SCAN_DAYS=7
# 二维码邮件超过多少分钟视为失效
QR_EXPIRE_MINUTES=30
# 单轮最多处理 / 最多移入回收站的邮件数（每个账号独立计）
MAX_PROCESS_PER_RUN=25
MAX_TRASH_PER_RUN=60
# 重要邮件即时推送的去重窗口（小时）：同一「发件人+主题」在窗口内只推一次
# 设为 0 关闭去重（每封都推）；不影响日报，日报中始终完整保留
IMPORTANT_DEDUP_HOURS=24

# ---- 验证码邮件 ----
# 验证码 / 验证链接类邮件超过该分钟数即移入回收站
CODE_EXPIRE_MINUTES=30
# 是否对「保护域」(银行/政务/支付宝等) 也清理验证码。0=保护域跳过（默认，最安全）
CODE_TRASH_PROTECTED=0

# ---- 广告识别调优 ----
# 显式营销域名（逗号分隔子串），命中即直接判广告。
# 用于平台营销子域这类光靠主题词难以稳定识别的发件人；谨慎使用——
# 命中后该域名的账号安全邮件也会一并被清理。
# 例：AD_DOMAINS=notice.gate.com,mail.instagram.com
AD_DOMAINS=
# 自定义补充广告词（逗号分隔），与内置词库同等生效
# 例：AD_EXTRA_KEYWORDS=限时抢购,最后机会
AD_EXTRA_KEYWORDS=

# ---- 多邮箱（可选）----
# 分号分隔多条记录，字段用 | 分隔：
#   名称|邮箱地址|授权码|IMAP服务器|端口|是否发ID命令|回收站文件夹
# 后四项可省略。Gmail 的回收站是 [Gmail]/Trash，必须显式指定。
# 留空则只用上面的单账号配置。
# 例：MAIL_ACCOUNTS=QQ|me@qq.com|授权码|imap.qq.com;Gmail|me@gmail.com|应用专用密码|imap.gmail.com|993|0|[Gmail]/Trash
MAIL_ACCOUNTS=
# 回收站文件夹名；留空则按 IMAP \Trash 属性自动识别
TRASH_FOLDER=
# 自定义豁免（逗号分隔子串，命中发件人/显示名/主题即永不清理）
PROTECT_EXTRA=
